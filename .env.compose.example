# Copy to .env.compose and replace all placeholder secrets before starting.
DJANGO_SECRET_KEY=replace-with-a-unique-random-value-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=fakeaccount
POSTGRES_USER=fakeaccount
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_ACTIVE_KEY_ID=primary
BACKUP_MAX_ATTEMPTS=5
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEYS=primary:replace-with-url-safe-base64-32-byte-key
