# Local development defaults. Replace both secrets before deployment.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8000,https://localhost:8000
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_HSTS_SECONDS=0

# Optional PostgreSQL connection. SQLite is used by default.
# To use PostgreSQL, set DJANGO_DATABASE=postgres and fill in these values.
DJANGO_DATABASE=sqlite
POSTGRES_DB=
POSTGRES_USER=fakeaccount
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production must configure a 32-byte URL-safe-base64 encryption key, for example:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ACTIVE_KEY_ID=primary
BACKUP_ENCRYPTION_KEYS=
BACKUP_LEGACY_SECRET_KEY=
BACKUP_RETENTION_COUNT=10
BACKUP_MAX_ATTEMPTS=5
